FROM niis/xroad-security-server-sidecar:7.6.2-primary-fi@sha256:94725d97b235a654a6a417d4ad0cf58b3659ee0b58edc9d57bab097a67f58f89

COPY ./local.ini /root/local.ini

CMD mkdir /etc/.ssh && \
    chmod 755 /etc/.ssh && \
    echo -n ${SSH_PUBLIC_KEY_BASE64} | base64 --decode > /etc/.ssh/id_rsa.pub && \
    chmod 644 /etc/.ssh/id_rsa.pub && \
    cp /root/local.ini /etc/xroad/conf.d/local.ini && \
    if [ -n "${MESSAGE_LOG_KEEP_RECORDS_FOR_DAYS:-}" ]; then \
      printf '\n[message-log]\nkeep-records-for=%s\n' "${MESSAGE_LOG_KEEP_RECORDS_FOR_DAYS}" >> /etc/xroad/conf.d/local.ini; \
    fi && \
    /root/entrypoint.sh

    
