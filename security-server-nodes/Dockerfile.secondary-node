FROM niis/xroad-security-server-sidecar:7.8.2-secondary-fi@sha256:8e1e7a788719c6b08dceac1114682741fec70f6eb13015dccf72bfd15ad17e23

CMD mkdir /etc/.ssh && \
    chmod 755 /etc/.ssh && \
    echo -n ${SSH_PRIVATE_KEY_BASE64} | base64 --decode > /etc/.ssh/id_rsa && \
    chmod 644 /etc/.ssh/id_rsa && \
    /root/entrypoint.sh
