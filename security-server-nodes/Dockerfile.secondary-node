FROM niis/xroad-security-server-sidecar:7.6.2-secondary-fi@sha256:2dabbdbdeef8067fa1116f09fec584cde98fb46abb36e43447d6a7182b34b97c

CMD mkdir /etc/.ssh && \
    chmod 755 /etc/.ssh && \
    echo -n ${SSH_PRIVATE_KEY_BASE64} | base64 --decode > /etc/.ssh/id_rsa && \
    chmod 644 /etc/.ssh/id_rsa && \
    /root/entrypoint.sh
